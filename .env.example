# Copy this file to ".env" and fill in your own values.
# .env is listed in .gitignore, so your key stays on your machine.

# API key for an OpenAI-compatible chat endpoint (OpenAI, LiteLLM proxy, vLLM, ...)
OPENAI_API_KEY=your-api-key-here

# Base URL of that endpoint
OPENAI_BASE_URL=https://your-llm-endpoint.example.com/

# Optional: the model to use. It must accept images (vision).
# Default if left out: Qwen/Qwen3.8-27B
LLM_MODEL=Qwen/Qwen3.8-27B
